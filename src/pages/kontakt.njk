---
layout: layouts/base.njk
title: Kontakt
permalink: /kontakt/
breadcrumb:
  - label: Kontakt
---
<div class="page-header">
  <div class="container">
    <h1 class="page-header__title">Kontakt</h1>
    <p class="page-header__subtitle">Schreiben Sie uns – wir freuen uns über Ihre Nachricht</p>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="grid grid--2">
      <div>
        <h2>Kontaktformular</h2>
        <form id="contact-form" action="/.netlify/functions/contact-form" method="POST" novalidate>
          <div class="form-group">
            <label class="form-label" for="contact-name">Name *</label>
            <input type="text" class="form-input" id="contact-name" name="name" required autocomplete="name">
            <span class="form-error" aria-live="polite"></span>
          </div>
          <div class="form-group">
            <label class="form-label" for="contact-email">E-Mail *</label>
            <input type="email" class="form-input" id="contact-email" name="email" required autocomplete="email">
            <span class="form-error" aria-live="polite"></span>
          </div>
          <div class="form-group">
            <label class="form-label" for="contact-subject">Betreff</label>
            <input type="text" class="form-input" id="contact-subject" name="subject">
          </div>
          <div class="form-group">
            <label class="form-label" for="contact-message">Nachricht *</label>
            <textarea class="form-textarea" id="contact-message" name="message" required></textarea>
            <span class="form-error" aria-live="polite"></span>
          </div>
          {# Honeypot #}
          <div style="position: absolute; left: -9999px;" aria-hidden="true">
            <label for="contact-fax">Fax</label>
            <input type="text" id="contact-fax" name="fax" tabindex="-1" autocomplete="off">
          </div>
          <button type="submit" class="btn btn--primary">Nachricht senden</button>
          <div id="contact-status" aria-live="polite" style="margin-top: var(--space-md);"></div>
        </form>
      </div>
      <div>
        <h2>Adresse</h2>
        <p>
          {{ site.address.name }}<br>
          {{ site.address.city }}, {{ site.address.country }}
        </p>
        {% if site.email %}
        <p>
          <strong>E-Mail:</strong><br>
          <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        </p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script src="/assets/js/contact-form.js" defer></script>
