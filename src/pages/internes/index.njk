---
layout: layouts/base.njk
title: Interner Bereich
permalink: /internes/
breadcrumb:
  - label: Internes
---
<div class="page-header">
  <div class="container">
    <h1 class="page-header__title">Interner Bereich</h1>
    <p class="page-header__subtitle">Nur für Mitglieder des SBV</p>
  </div>
</div>

<section class="section">
  <div class="container">
    <div id="internes-login" style="max-width: 400px; margin: 0 auto; text-align: center;">
      <p>Dieser Bereich ist nur für angemeldete Mitglieder zugänglich.</p>
      <div style="margin-top: var(--space-lg);">
        <div style="text-align: left;">
          <label for="int-user" style="display: block; font-weight: 600; margin-bottom: var(--space-xs);">Benutzername</label>
          <input type="text" id="int-user" class="form-input" autocomplete="username" style="margin-bottom: var(--space-md);">
          <label for="int-pass" style="display: block; font-weight: 600; margin-bottom: var(--space-xs);">Passwort</label>
          <input type="password" id="int-pass" class="form-input" autocomplete="current-password" style="margin-bottom: var(--space-md);">
        </div>
        <p id="int-error" style="color: #e74c3c; display: none; margin-bottom: var(--space-md);">Benutzername oder Passwort falsch.</p>
        <button id="int-login-btn" class="btn btn--primary" style="width: 100%;">Anmelden</button>
      </div>
    </div>

    <div id="internes-content" style="display: none;">
      <h2>Willkommen im internen Bereich</h2>
      <p>Hier finden Sie interne Dokumente und Informationen für Vereinsvertreter.</p>

      <div style="margin-top: var(--space-xl);">
        <h3>Interne Dokumente</h3>
        <p>Interne Dokumente werden hier nach Anmeldung bereitgestellt.</p>
      </div>

      <p style="margin-top: var(--space-xl);">
        <button id="logout-btn" class="btn btn--outline">Abmelden</button>
      </p>
    </div>
  </div>
</section>

<script>
  (function() {
    var AUTH_USER = 'admin';
    var AUTH_PASS = 'admin';
    var SESSION_KEY = 'internes_authenticated';

    var loginBox = document.getElementById('internes-login');
    var contentBox = document.getElementById('internes-content');
    var errorMsg = document.getElementById('int-error');

    function showContent() {
      loginBox.style.display = 'none';
      contentBox.style.display = 'block';
    }

    function showLogin() {
      loginBox.style.display = 'block';
      contentBox.style.display = 'none';
    }

    if (sessionStorage.getItem(SESSION_KEY) === 'true') {
      showContent();
    }

    function tryLogin() {
      var user = document.getElementById('int-user').value;
      var pass = document.getElementById('int-pass').value;
      if (user === AUTH_USER && pass === AUTH_PASS) {
        sessionStorage.setItem(SESSION_KEY, 'true');
        showContent();
      } else {
        errorMsg.style.display = 'block';
      }
    }

    document.getElementById('int-login-btn').addEventListener('click', tryLogin);
    document.getElementById('int-pass').addEventListener('keydown', function(e) {
      if (e.key === 'Enter') tryLogin();
    });

    document.getElementById('logout-btn').addEventListener('click', function() {
      sessionStorage.removeItem(SESSION_KEY);
      showLogin();
    });
  })();
</script>
