    <h1 class="page-header__title">{{ title }}</h1>
    {% if subtitle %}
    <p class="page-header__subtitle">{{ subtitle }}</p>
    {% endif %}
  </div>
</div>

{% include "partials/breadcrumb.njk" %}

<section class="section">
  <div class="container">
    <div class="content">
      {{ content | safe }}
    </div>
  </div>
</section>
